{
  "manifest_version": 3,
  "name": "LiveMarksTab",
  "version": "1.0.0",
  "description": "LiveMarksTab — 自定义新标签页书签导航，实时同步 Chrome 书签",
  "permissions": ["bookmarks", "favicon", "storage"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
